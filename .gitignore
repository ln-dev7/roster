# macOS
.DS_Store

# Xcode — the .xcodeproj is GENERATED by XcodeGen (app/project.yml is the
# source of truth), so it is not versioned.
*.xcodeproj
xcuserdata/
DerivedData/
*.xcresult

# Generated by XcodeGen from app/project.yml, same as the .xcodeproj.
app/SupportingFiles/Info.plist

# Build and release output
build/
dist/
*.dmg

# Swift Package Manager
.build/
.swiftpm/

# Site (later)
site/node_modules/
site/.next/
site/.vercel/
site/next-env.d.ts
site/tsconfig.tsbuildinfo

# Python bytecode from future scripts
__pycache__/

# Scratch folder used when files are moved aside; never part of the app.
_to_delete/
